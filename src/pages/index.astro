---
import logo from "../img/logo_notext.png";

const year = new Date().getFullYear();
const demo = "mailto:contact@mimiranalysis.com";

/* Hero app preview: revenue chart data */
const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep"];
const total = [82, 86, 91, 95, 99, 104, 92, 87, 84];
const north = [30, 31, 33, 34, 36, 38, 29, 25, 22];
const X0 = 40, STEP = 52, BW = 30, BASE = 172, K = 1.4;
const bars = total.map((v, i) => ({
  x: X0 + i * STEP,
  y: +(BASE - v * K).toFixed(1),
  h: +(v * K).toFixed(1),
  m: months[i],
  q3: i >= 6,
  d: (0.9 + i * 0.05).toFixed(2) + "s",
}));
const northPts = north.map((v, i) => `${X0 + i * STEP + BW / 2},${(BASE - v * K).toFixed(1)}`).join(" ");
const gridVals = [25, 50, 75, 100].map((v) => ({ v, y: +(BASE - v * K).toFixed(1) }));
const q3x = bars[6].x - 9;
const q3w = bars[8].x + BW + 9 - q3x;

const steps = [
  { n: "01", title: "Upload Your Data", text: "Drag and drop your files - Mimir supports all major formats." },
  { n: "02", title: "Analyze Instantly", text: "Mimir scans your data, detects patterns, highlights anomalies, and draws clear charts - all in seconds." },
  { n: "03", title: "Explore & Act", text: "Get actionable insights, follow-up questions, and recommendations. Refine your analysis and uncover opportunities you didn’t know existed." },
];

const testimonials = [
  { quote: "It’s like having a data expert on my team. Mimir not only shows patterns but tells me what to do next.", name: "Sarah Chen", role: "Data Analyst" },
  { quote: "Mimir cut my analysis time from hours to minutes. I finally understand what my data is telling me.", name: "Marcus Rodriguez", role: "Researcher" },
  { quote: "We had piles of data with no insights. Mimir turned it into actionable strategies in an instant.", name: "Emily Watson", role: "CFO" },
];

const comparison = [
  { feature: "Instant Analysis", mimir: "Instant Charts and Insights", others: "Slow or Manual" },
  { feature: "Actionable Advice", mimir: "Mimir Suggests Next Steps", others: "Just Raw Numbers" },
  { feature: "Smart Follow-Ups", mimir: "Guides Deeper Exploration", others: "None" },
  { feature: "Data Control", mimir: "Full Ownership", others: "Shared Access" },
  { feature: "Ease of Use", mimir: "Drag & drop, zero setup", others: "Complex Dashboards" },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mimir - See Beyond Data.</title>
  <meta name="description" content="Your Personal AI Data Analyst - Turning Numbers Into Answers" />
  <meta name="theme-color" content="#0a0e17" />
  <meta property="og:title" content="Mimir - See Beyond Data." />
  <meta property="og:description" content="Your Personal AI Data Analyst - Turning Numbers Into Answers" />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/x-icon" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&display=swap" rel="stylesheet" />

  <style is:global>
    /*
      Palette (unchanged brand colours)
        ground   #0a0e17   surface  #0d1117   raised  #161b22
        accent   #009DFF   text     #e0e0e0   muted   #8892a6
      One accent, used for actions and data only. No gradients on type or surfaces.
    */
    :root {
      --bg: #0a0e17;
      --bg-2: #0d1117;
      --bg-3: #161b22;
      --accent: #009DFF;
      --accent-hi: #33b1ff;
      --line: rgba(136, 146, 166, 0.14);
      --line-2: rgba(136, 146, 166, 0.24);
      --line-accent: rgba(0, 157, 255, 0.35);
      --ink: #ffffff;
      --text: #e0e0e0;
      --soft: #c9d1d9;
      --muted: #8892a6;
      --dim: #6e7681;
      --green: #3fb950;
      --red: #f85149;
      --wrap: 1200px;
      --pad: clamp(20px, 4vw, 40px);
      --sans: "Geist", -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", system-ui, sans-serif;
      --code: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
      --ease: cubic-bezier(0.2, 0.7, 0.1, 1);
    }

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-padding-top: 72px; }
    body {
      font-family: var(--sans);
      font-size: 16px;
      color: var(--text);
      background: var(--bg);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }
    img, svg { display: block; }
    a { color: inherit; }
    ::selection { background: rgba(0, 157, 255, 0.35); color: #fff; }

    .wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 var(--pad); position: relative; z-index: 1; }
    .skip {
      position: absolute; left: 12px; top: -60px; z-index: 100;
      background: var(--accent); color: var(--bg); padding: 10px 16px; border-radius: 6px;
      font-weight: 600; text-decoration: none;
    }
    .skip:focus { top: 12px; }
    :focus-visible { outline: 2px solid var(--accent-hi); outline-offset: 3px; border-radius: 4px; }

    /* ---------- Buttons ---------- */
    .btn {
      display: inline-flex; align-items: center; justify-content: center;
      min-height: 48px; padding: 0 28px;
      font: 500 15px/1 var(--sans);
      text-decoration: none; border-radius: 6px; cursor: pointer;
      transition: transform 0.2s var(--ease), background 0.2s, border-color 0.2s, color 0.2s;
    }
    .btn:active { transform: translateY(0) scale(0.98); }
    .btn-primary { background: var(--accent); color: var(--bg); }
    .btn-primary:hover { background: var(--accent-hi); transform: translateY(-2px); }
    .btn-quiet {
      min-height: 40px; padding: 0 16px; font-size: 14px;
      color: var(--ink); border: 1px solid var(--line-2);
    }
    .btn-quiet:hover { border-color: var(--accent); transform: translateY(-1px); }

    /* ---------- Nav ---------- */
    .nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 50;
      border-bottom: 1px solid transparent;
      transition: background 0.3s, border-color 0.3s;
    }
    .nav.scrolled {
      background: rgba(10, 14, 23, 0.9);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom-color: var(--line);
    }
    .nav .wrap { display: flex; align-items: center; justify-content: space-between; height: 68px; }
    .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); font-weight: 600; font-size: 17px; letter-spacing: 0.08em; }
    .brand img { width: 28px; height: 28px; }
    .nav-links { display: flex; gap: 4px; list-style: none; }
    .nav-links a {
      display: inline-flex; align-items: center; min-height: 40px; padding: 0 14px;
      font-size: 14px; color: var(--muted); text-decoration: none; position: relative; transition: color 0.2s;
    }
    .nav-links a::after {
      content: ""; position: absolute; left: 14px; right: 14px; bottom: 8px; height: 1px;
      background: var(--ink); transform: scaleX(0); transform-origin: left; transition: transform 0.3s var(--ease);
    }
    .nav-links a:hover { color: var(--ink); }
    .nav-links a:hover::after { transform: scaleX(1); }

    /* ---------- Hero ---------- */
    .hero { position: relative; padding: 156px 0 0; text-align: center; overflow: hidden; }
    .hero-mark { position: relative; width: 72px; height: 72px; margin: 0 auto 36px; display: grid; place-items: center; }
    .hero-mark img { width: 48px; height: 48px; position: relative; z-index: 1; }
    .hero-mark::after {
      content: ""; position: absolute; inset: -10px; border-radius: 50%;
      border: 1px solid var(--line-2);
    }
    .hero-mark .orbit { position: absolute; inset: -10px; animation: spin 8s linear infinite; }
    .hero-mark .orbit::before {
      content: ""; position: absolute; top: -2.5px; left: 50%; width: 5px; height: 5px; margin-left: -2.5px;
      border-radius: 50%; background: var(--accent);
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    h1 {
      font-size: clamp(54px, 9vw, 120px);
      line-height: 0.96; font-weight: 600; letter-spacing: -0.05em; color: var(--ink);
      margin-bottom: 24px;
    }
    .subheadline { font-size: clamp(17px, 1.5vw, 19px); color: var(--muted); max-width: 640px; margin: 0 auto 40px; }

    [data-enter] { animation: enter 0.9s var(--ease) var(--d, 0s) both; }
    @keyframes enter { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

    /* Stage: horizon line and moving grid floor behind the app */
    .stage { position: relative; margin-top: 84px; }
    .floor {
      position: absolute; left: 50%; top: 64px; width: 2600px; height: 900px; margin-left: -1300px;
      background-image:
        linear-gradient(rgba(0, 157, 255, 0.45) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 157, 255, 0.45) 1px, transparent 1px);
      background-size: 80px 80px;
      transform: perspective(520px) rotateX(64deg);
      transform-origin: 50% 0;
      mask-image: linear-gradient(to bottom, transparent 0%, #000 10%, rgba(0, 0, 0, 0.5) 45%, transparent 78%);
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 10%, rgba(0, 0, 0, 0.5) 45%, transparent 78%);
      opacity: 0.28;
      animation: floor 3.5s linear infinite;
      pointer-events: none;
    }
    @keyframes floor { to { background-position: 0 80px; } }
    .horizon { position: absolute; left: 0; right: 0; top: 64px; height: 1px; background: rgba(0, 157, 255, 0.45); pointer-events: none; }

    /* ---------- App preview ---------- */
    .app {
      position: relative; z-index: 2; text-align: left;
      max-width: 1120px; margin: 0 auto;
      border-radius: 10px 10px 0 0;
      border: 1px solid var(--line-2); border-bottom: 0;
      background: var(--bg-2);
      font-size: 13px;
      font-variant-numeric: tabular-nums;
      overflow: hidden;
    }
    .app-bar {
      display: flex; align-items: center; gap: 14px; height: 42px; padding: 0 16px;
      border-bottom: 1px solid var(--line); font-size: 12px; color: var(--dim); background: var(--bg-3);
    }
    .dots { display: flex; gap: 7px; }
    .dots i { width: 10px; height: 10px; border-radius: 50%; background: #2a3140; }
    .app-title { flex: 1; text-align: center; color: var(--muted); }
    .status { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); }
    .status i { width: 6px; height: 6px; border-radius: 50%; background: var(--green); animation: blink 2.4s ease-in-out infinite; }
    @keyframes blink { 50% { opacity: 0.3; } }

    .app-body { display: grid; grid-template-columns: 200px 1fr 264px; min-height: 510px; }
    .app-side { border-right: 1px solid var(--line); padding: 16px 12px; display: flex; flex-direction: column; gap: 2px; }
    .side-label { font-size: 12px; color: var(--dim); margin: 4px 8px 6px; }
    .side-label.next { margin-top: 20px; }
    .chat-item { padding: 8px 10px; border-radius: 6px; color: var(--muted); }
    .chat-item.on { background: var(--bg-3); color: var(--ink); }
    .file-pill { margin: 0 2px; padding: 10px; border-radius: 6px; border: 1px solid var(--line); }
    .file-pill strong { display: block; color: var(--soft); font-weight: 500; font-family: var(--code); font-size: 12px; }
    .file-pill span { display: block; margin-top: 2px; color: var(--dim); font-size: 12px; }

    .app-main { padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 16px; min-width: 0; }
    .q { align-self: flex-end; max-width: 80%; padding: 9px 14px; border-radius: 8px; background: var(--bg-3); border: 1px solid var(--line-2); color: var(--ink); }
    .answer { display: flex; gap: 12px; }
    .answer img { width: 20px; height: 20px; flex: none; margin-top: 1px; }
    .answer p { color: var(--soft); line-height: 1.65; }
    .answer p b { color: var(--ink); font-weight: 600; }

    .chart-card { border: 1px solid var(--line); border-radius: 8px; padding: 14px 16px 10px; }
    .chart-head { display: flex; align-items: center; gap: 16px; margin-bottom: 8px; }
    .chart-head h4 { font-size: 13px; font-weight: 500; color: var(--ink); flex: 1; }
    .legend { display: flex; gap: 14px; color: var(--muted); font-size: 12px; }
    .legend span { display: inline-flex; align-items: center; gap: 6px; }
    .legend i { width: 10px; height: 10px; border-radius: 2px; background: var(--accent); }
    .legend i.l { height: 2px; border-radius: 0; background: var(--soft); }
    .exports { display: flex; gap: 4px; }
    .exports span { font-size: 11px; color: var(--muted); padding: 2px 7px; border-radius: 4px; border: 1px solid var(--line); }
    .chart { width: 100%; height: auto; overflow: visible; }
    .chart .gl { stroke: var(--line); stroke-width: 1; }
    .chart text { font-family: var(--sans); font-size: 10px; fill: var(--dim); }
    .chart .bar { fill: rgba(0, 157, 255, 0.4); transform-box: fill-box; transform-origin: 50% 100%; animation: grow 0.9s var(--ease) var(--bd, 1s) both; }
    .chart .bar.q3 { fill: var(--accent); }
    .chart .band { fill: rgba(248, 81, 73, 0.05); stroke: rgba(248, 81, 73, 0.4); stroke-dasharray: 3 4; }
    .chart .band-label { fill: var(--red); font-weight: 500; }
    .chart .nline { fill: none; stroke: var(--soft); stroke-width: 1.75; stroke-dasharray: 1; stroke-dashoffset: 1; animation: drawOnce 1.4s var(--ease) 1.6s forwards; }
    .chart .ndot { fill: var(--bg-2); stroke: var(--soft); stroke-width: 1.5; opacity: 0; animation: fadeIn 0.4s 2.6s forwards; }
    @keyframes grow { from { transform: scaleY(0); } to { transform: scaleY(1); } }
    @keyframes drawOnce { to { stroke-dashoffset: 0; } }
    @keyframes fadeIn { to { opacity: 1; } }

    .chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .chip { padding: 6px 12px; border-radius: 6px; border: 1px solid var(--line-2); color: var(--soft); font-size: 12px; }

    .app-rec { border-left: 1px solid var(--line); padding: 18px 16px; display: flex; flex-direction: column; gap: 12px; }
    .rec-title { font-weight: 600; color: var(--ink); font-size: 13px; }
    .rec { border: 1px solid var(--line); border-radius: 8px; padding: 14px; }
    .rec.lead { border-color: var(--line-accent); }
    .rec h5 { font-size: 13px; font-weight: 600; color: var(--ink); margin-bottom: 10px; line-height: 1.4; }
    .rec dl { display: grid; gap: 8px; }
    .rec dt { font-size: 11px; color: var(--dim); }
    .rec dd { font-size: 12.5px; }
    .rec dd.up { color: var(--green); }
    .rec dd.down { color: var(--red); }
    .rec .why { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; line-height: 1.55; }

    /* ---------- Sections ---------- */
    .section { position: relative; padding: clamp(96px, 11vw, 144px) 0; border-top: 1px solid var(--line); }
    .section.alt { background: var(--bg-2); }
    .sec-title { font-size: clamp(36px, 4.4vw, 56px); line-height: 1.05; letter-spacing: -0.035em; font-weight: 600; color: var(--ink); margin-bottom: clamp(44px, 5vw, 64px); }

    /* Pointer-following hairline (hover only) */
    .spot { position: relative; }
    .spot::before {
      content: ""; position: absolute; inset: -1px; z-index: 2; pointer-events: none;
      border-radius: inherit; padding: 1px;
      background: radial-gradient(280px circle at var(--mx, 50%) var(--my, 0%), rgba(0, 157, 255, 0.55), transparent 60%);
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor; mask-composite: exclude;
      opacity: 0; transition: opacity 0.3s;
    }
    .spot:hover::before { opacity: 1; }

    /* ---------- Features: one panel split by hairlines ---------- */
    .feature-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
      background: var(--line); border: 1px solid var(--line); border-radius: 10px; overflow: hidden;
    }
    .feature { background: var(--bg-2); padding: 28px 28px 36px; transition: background 0.25s; }
    .feature:hover { background: #10151d; }
    .feature h3 { font-size: 18px; font-weight: 600; color: var(--ink); letter-spacing: -0.01em; line-height: 1.35; margin: 26px 0 10px; }
    .feature p { color: var(--muted); font-size: 15px; line-height: 1.65; max-width: 44ch; }
    .feature p b { display: block; margin-top: 10px; color: var(--soft); font-weight: 500; }

    .viz { position: relative; height: 168px; border-radius: 6px; overflow: hidden; border: 1px solid var(--line); background: var(--bg); }

    /* viz: analysis */
    .viz-analysis svg { position: absolute; inset: 14px 0 0; width: 100%; height: calc(100% - 14px); }
    .viz-analysis .gl { stroke: var(--line); }
    .viz-analysis .ln { fill: none; stroke: var(--accent); stroke-width: 1.75; animation: wipeLoop 4s var(--ease) infinite; }
    .viz-analysis .ar { animation: areaLoop 4s var(--ease) infinite; }
    @keyframes wipeLoop { 0% { clip-path: inset(0 100% 0 0); opacity: 1; } 45%, 85% { clip-path: inset(0 0 0 0); opacity: 1; } 100% { clip-path: inset(0 0 0 0); opacity: 0; } }
    @keyframes areaLoop { 0%, 30% { opacity: 0; } 50%, 85% { opacity: 1; } 100% { opacity: 0; } }
    .anomaly { position: absolute; width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%; background: var(--red); animation: ping 4s var(--ease) infinite; }
    .anomaly::after { content: ""; position: absolute; inset: -8px; border-radius: 50%; border: 1px solid var(--red); animation: ring 4s var(--ease) infinite; }
    @keyframes ping { 0%, 40% { opacity: 0; transform: scale(0.4); } 50%, 88% { opacity: 1; transform: scale(1); } 100% { opacity: 0; } }
    @keyframes ring { 0%, 50% { opacity: 0; transform: scale(0.5); } 60% { opacity: 1; } 80%, 100% { opacity: 0; transform: scale(1.6); } }
    .viz-tag { position: absolute; font-size: 11px; padding: 3px 8px; border-radius: 4px; background: var(--bg-3); color: var(--red); border: 1px solid rgba(248, 81, 73, 0.4); animation: ping 4s var(--ease) infinite; white-space: nowrap; }
    .scan { position: absolute; top: 0; bottom: 0; left: 0; width: 1px; background: rgba(0, 157, 255, 0.6); animation: scan 4s linear infinite; }
    @keyframes scan { 0% { left: 0; opacity: 0; } 5% { opacity: 1; } 45% { left: 100%; opacity: 1; } 46%, 100% { left: 100%; opacity: 0; } }

    /* viz: rows cycling (recommendations, follow-ups) */
    .viz-rows { display: flex; flex-direction: column; justify-content: center; gap: 8px; padding: 14px; }
    .vrow {
      display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 6px;
      border: 1px solid var(--line); background: var(--bg-2); color: var(--soft); font-size: 13px;
      animation: rowOn 3.6s var(--ease) infinite; animation-delay: var(--rd, 0s);
    }
    @keyframes rowOn {
      0%, 8% { border-color: var(--line); transform: none; }
      14%, 30% { border-color: var(--line-accent); transform: translateX(4px); }
      40%, 100% { border-color: var(--line); transform: none; }
    }
    .vrow .dot { width: 7px; height: 7px; border-radius: 50%; flex: none; }
    .dot.g { background: var(--green); } .dot.r { background: var(--red); } .dot.b { background: var(--accent); }
    .vrow .meter { margin-left: auto; width: 64px; height: 3px; border-radius: 3px; background: var(--line-2); overflow: hidden; }
    .vrow .meter em { display: block; height: 100%; width: var(--w); background: currentColor; }
    .vrow.ask { font-size: 12.5px; }

    /* viz: timeline */
    .viz-time svg { position: absolute; left: 16px; right: 16px; top: 20px; width: calc(100% - 32px); height: 80px; overflow: visible; }
    .viz-time .ln { fill: none; stroke: var(--accent); stroke-width: 1.75; animation: wipeLoop 4s var(--ease) infinite; }
    .files { position: absolute; left: 12px; right: 12px; bottom: 14px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
    .files span {
      font-family: var(--code); font-size: 11px; text-align: center; padding: 5px 0; border-radius: 4px;
      border: 1px solid var(--line); color: var(--dim); background: var(--bg-2);
      animation: fileOn 4s var(--ease) infinite; animation-delay: var(--fd);
    }
    @keyframes fileOn { 0% { color: var(--dim); border-color: var(--line); } 8%, 70% { color: var(--ink); border-color: var(--line-accent); } 100% { color: var(--dim); border-color: var(--line); } }

    /* viz: drop zone */
    .viz-drop { display: grid; place-items: center; }
    .zone {
      position: relative; width: 76%; height: 96px; border-radius: 6px;
      border: 1px dashed var(--line-2); display: grid; place-items: center;
      animation: zoneOn 3.2s var(--ease) infinite;
    }
    @keyframes zoneOn { 0%, 35% { border-color: var(--line-2); } 50%, 75% { border-color: var(--accent); } 100% { border-color: var(--line-2); } }
    .drop-file {
      padding: 7px 12px; border-radius: 4px; background: var(--bg-3); border: 1px solid var(--line-2);
      font-family: var(--code); font-size: 12px; color: var(--soft);
      animation: dropIn 3.2s var(--ease) infinite;
    }
    @keyframes dropIn { 0% { transform: translate(40px, -80px) rotate(6deg); opacity: 0; } 15% { opacity: 1; } 45%, 85% { transform: none; opacity: 1; } 100% { transform: none; opacity: 0; } }
    .fmts { position: absolute; bottom: 10px; display: flex; gap: 6px; }
    .fmts span { font-family: var(--code); font-size: 11px; color: var(--dim); }

    /* viz: secure */
    .viz-lock { display: grid; place-items: center; }
    .rings { position: relative; width: 136px; height: 136px; display: grid; place-items: center; }
    .rings i { position: absolute; border-radius: 50%; border: 1px solid var(--line-2); }
    .rings i:nth-child(1) { inset: 0; border-style: dashed; animation: spin 30s linear infinite; }
    .rings i:nth-child(2) { inset: 18px; animation: spin 10s linear infinite reverse; border-top-color: var(--accent); }
    .rings i:nth-child(3) { inset: 36px; animation: spin 4s linear infinite; border-right-color: var(--soft); }
    .rings svg { width: 22px; height: 22px; color: var(--ink); }

    /* ---------- How it works ---------- */
    .how-grid { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
    .how-intro { position: sticky; top: 112px; }
    .pipe { border: 1px solid var(--line); border-radius: 10px; padding: 10px; background: var(--bg-2); }
    .pipe svg { width: 100%; height: auto; }
    .pipe .wire { fill: none; stroke: var(--line-2); stroke-width: 1.25; }
    .pipe .pulse { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 0.08 1; stroke-dashoffset: 1.08; animation: pulse 3s linear infinite; }
    .pipe .pulse.p2 { animation-delay: 0.4s; } .pipe .pulse.p3 { animation-delay: 0.8s; } .pipe .pulse.p4 { animation-delay: 1.2s; }
    @keyframes pulse { to { stroke-dashoffset: 0; } }
    .pipe .box { fill: var(--bg); stroke: var(--line-2); }
    .pipe .hub { fill: var(--bg-3); stroke: var(--line-accent); }
    .pipe text { font-family: var(--sans); font-size: 13px; fill: var(--soft); }

    .timeline { list-style: none; position: relative; }
    .timeline::before { content: ""; position: absolute; left: 23px; top: 36px; bottom: 36px; width: 1px; background: var(--line-2); }
    .timeline::after {
      content: ""; position: absolute; left: 23px; top: 36px; width: 1px; height: 72px;
      background: linear-gradient(transparent, var(--accent), transparent);
      animation: travel 3.6s var(--ease) infinite;
    }
    @keyframes travel { 0% { transform: translateY(0); opacity: 0; } 10%, 90% { opacity: 1; } 100% { transform: translateY(var(--tl-h, 400px)); opacity: 0; } }
    .step { position: relative; display: grid; grid-template-columns: 48px 1fr; gap: 28px; padding: 32px 0; }
    .step + .step { border-top: 1px solid var(--line); }
    .node {
      position: relative; z-index: 1; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center;
      font-size: 15px; font-weight: 500; color: var(--ink);
      background: var(--bg); border: 1px solid var(--line-2);
      transition: border-color 0.3s, color 0.3s;
    }
    .step:hover .node { border-color: var(--accent); color: var(--accent); }
    .step h3 { font-size: clamp(21px, 2vw, 26px); font-weight: 600; letter-spacing: -0.02em; color: var(--ink); margin: 8px 0 8px; }
    .step p { color: var(--muted); font-size: 16px; max-width: 54ch; }

    /* ---------- Testimonials ---------- */
    .quotes { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line-2); }
    .quote { display: flex; flex-direction: column; justify-content: space-between; gap: 36px; padding: 36px 36px 8px 0; }
    .quote + .quote { padding-left: 36px; border-left: 1px solid var(--line); }
    .quote blockquote { font-size: clamp(18px, 1.6vw, 21px); line-height: 1.5; color: var(--ink); letter-spacing: -0.012em; }
    .who strong { display: block; color: var(--soft); font-weight: 500; font-size: 15px; }
    .who span { color: var(--dim); font-size: 14px; }

    /* ---------- Comparison ---------- */
    .cmp { display: grid; grid-template-columns: 1.3fr 1.15fr 1fr; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
    .cmp-row { display: contents; }
    .cmp-row > div { display: flex; align-items: center; gap: 12px; padding: 20px 28px; border-top: 1px solid var(--line); font-size: 15px; color: var(--muted); transition: background 0.2s; }
    .cmp-head > div { border-top: 0; font-size: 13px; font-weight: 500; color: var(--dim); padding-top: 18px; padding-bottom: 18px; background: var(--bg-2); }
    .cmp-row > .feat { color: var(--soft); font-weight: 500; }
    .cmp-row > .m { color: var(--ink); background: rgba(0, 157, 255, 0.05); box-shadow: 1px 0 0 var(--line) inset, -1px 0 0 var(--line) inset; }
    .cmp-head > .m { color: var(--ink); box-shadow: 1px 0 0 var(--line) inset, -1px 0 0 var(--line) inset, 0 2px 0 var(--accent) inset; background: rgba(0, 157, 255, 0.07); }
    .cmp-head > .m img { width: 16px; height: 16px; }
    .cmp-row:not(.cmp-head):hover > div { background: rgba(136, 146, 166, 0.04); }
    .cmp-row:not(.cmp-head):hover > .m { background: rgba(0, 157, 255, 0.09); }
    .ic { width: 16px; height: 16px; flex: none; }
    .ic.yes { color: var(--green); } .ic.no { color: var(--red); }
    .cell-label { display: none; }

    /* ---------- Final CTA ---------- */
    .final { position: relative; overflow: hidden; text-align: center; padding: clamp(120px, 14vw, 180px) 0; border-top: 1px solid var(--line); }
    .final-rings { position: absolute; left: 50%; top: 50%; width: 1100px; height: 1100px; transform: translate(-50%, -50%); pointer-events: none; }
    .final-rings i { position: absolute; inset: 0; border-radius: 50%; border: 1px solid rgba(136, 146, 166, 0.07); }
    .final-rings i:nth-child(2) { inset: 150px; border-color: rgba(136, 146, 166, 0.09); }
    .final-rings i:nth-child(3) { inset: 300px; border-color: rgba(0, 157, 255, 0.2); border-style: dashed; animation: spin 40s linear infinite; }
    .final-rings i:nth-child(4) { inset: 420px; border-color: rgba(136, 146, 166, 0.12); }
    .final h2 { position: relative; font-size: clamp(42px, 6.4vw, 84px); line-height: 1; letter-spacing: -0.045em; font-weight: 600; color: var(--ink); max-width: 900px; margin: 0 auto 24px; }
    .final p { position: relative; font-size: clamp(17px, 1.5vw, 19px); color: var(--muted); max-width: 600px; margin: 0 auto 40px; }

    /* ---------- Footer ---------- */
    footer { border-top: 1px solid var(--line); padding: 36px 0 40px; font-size: 13px; color: var(--dim); position: relative; z-index: 1; }
    .foot { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
    .foot .brand { font-size: 15px; }
    .foot .brand img { width: 24px; height: 24px; }
    .social { display: flex; gap: 4px; }
    .social a { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 6px; color: var(--dim); transition: color 0.2s, transform 0.2s var(--ease); }
    .social a:hover { color: var(--ink); transform: translateY(-2px); }
    .social svg { width: 19px; height: 19px; }

    /* ---------- Responsive ---------- */
    @media (max-width: 1100px) {
      .app-body { grid-template-columns: 1fr 250px; }
      .app-side { display: none; }
    }
    @media (max-width: 1000px) {
      .feature-grid { grid-template-columns: repeat(2, 1fr); }
      .how-grid { grid-template-columns: 1fr; }
      .how-intro { position: static; }
      .quotes { grid-template-columns: 1fr; }
      .quote, .quote + .quote { padding: 32px 0; border-left: 0; }
      .quote + .quote { border-top: 1px solid var(--line); }
    }
    @media (max-width: 820px) {
      .nav-links { display: none; }
      .app-body { grid-template-columns: 1fr; }
      .app-rec { border-left: 0; border-top: 1px solid var(--line); }
      .exports { display: none; }
    }
    @media (max-width: 640px) {
      .hero { padding-top: 128px; }
      .hero .btn-primary, .final .btn-primary { width: 100%; }
      .stage { margin-top: 60px; }
      .app-title { display: none; }
      .status { margin-left: auto; }
      .app-main { padding: 18px 16px 20px; }
      .app-rec { display: none; }
      .q { max-width: 100%; }
      .feature-grid { grid-template-columns: 1fr; }
      .feature { padding: 22px 20px 30px; }
      .step { grid-template-columns: 40px 1fr; gap: 20px; }
      .node { width: 40px; height: 40px; font-size: 14px; }
      .timeline::before, .timeline::after { left: 19px; }
      .cmp { display: flex; flex-direction: column; gap: 12px; border: 0; overflow: visible; }
      .cmp-row.cmp-head { display: none; }
      .cmp-row { display: block; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
      .cmp-row > div { padding: 13px 16px; flex-wrap: wrap; gap: 10px; }
      .cmp-row > .feat { border-top: 0; color: var(--ink); font-weight: 600; background: var(--bg-2); }
      .cmp-row > .m { box-shadow: none; }
      .cell-label { display: block; width: 100%; font-size: 12px; color: var(--dim); margin-bottom: -4px; }
      .foot { flex-direction: column; text-align: center; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; animation-delay: 0s !important; transition-duration: 0.001ms !important; }
      html { scroll-behavior: auto; }
      .viz-analysis .ln, .viz-time .ln { clip-path: none !important; opacity: 1 !important; animation: none !important; }
      .chart .nline { stroke-dashoffset: 0 !important; animation: none !important; }
      .scan, .timeline::after { display: none; }
    }
    .paused, .paused * { animation-play-state: paused !important; }
  </style>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="nav" id="nav">
    <div class="wrap">
      <a class="brand" href="#top" aria-label="Mimir home">
        <img src={logo.src} alt="" width="28" height="28" />
        <span>MIMIR</span>
      </a>
      <nav aria-label="Main">
        <ul class="nav-links">
          <li><a href="#features">Features</a></li>
          <li><a href="#how">How It Works</a></li>
          <li><a href="#testimonials">Testimonials</a></li>
          <li><a href="#comparison">Comparison</a></li>
        </ul>
      </nav>
      <a class="btn btn-quiet" href={demo}>Schedule a Demo</a>
    </div>
  </header>

  <main id="main">
    <!-- ================= HERO ================= -->
    <section class="hero" id="top">
      <div class="wrap">
        <div class="hero-mark" data-enter style="--d:0s">
          <span class="orbit" aria-hidden="true"></span>
          <img src={logo.src} alt="Mimir logo" width="48" height="48" />
        </div>
        <h1 data-enter style="--d:.1s">See Beyond Data.</h1>
        <p class="subheadline" data-enter style="--d:.2s">Your Personal AI Data Analyst - Turning Numbers Into Answers</p>
        <div data-enter style="--d:.3s">
          <a href={demo} class="btn btn-primary">Schedule a Free Demo Today</a>
        </div>
      </div>

      <div class="stage">
        <div class="floor" aria-hidden="true"></div>
        <div class="horizon" aria-hidden="true"></div>
        <div class="wrap">
          <!-- Product preview: an analysis inside the Mimir app. Sample data; edit freely. -->
          <div class="app" data-enter style="--d:.45s" role="img" aria-label="The Mimir app answering a question about a sales file with a summary, a chart, follow-up questions and recommendations">
            <div class="app-bar" aria-hidden="true">
              <span class="dots"><i></i><i></i><i></i></span>
              <span class="app-title">sales_2025.csv</span>
              <span class="status"><i></i>Analysis complete</span>
            </div>
            <div class="app-body" aria-hidden="true">
              <aside class="app-side">
                <div class="side-label">Chats</div>
                <div class="chat-item on">Q3 revenue review</div>
                <div class="chat-item">Churn by plan</div>
                <div class="chat-item">Supplier merge</div>
                <div class="side-label next">Dataset</div>
                <div class="file-pill">
                  <strong>sales_2025.csv</strong>
                  <span>48,210 rows, 14 columns</span>
                </div>
              </aside>

              <div class="app-main">
                <div class="q">Which region drove the drop in Q3 revenue?</div>
                <div class="answer">
                  <img src={logo.src} alt="" width="20" height="20" />
                  <p>Q3 revenue fell <b>12.4%</b> against Q2. Most of the drop (<b>71%</b>) came from the <b>North</b> region, where repeat orders slowed from July onward. Other regions held steady.</p>
                </div>
                <div class="chart-card">
                  <div class="chart-head">
                    <h4>Revenue by month, € thousands</h4>
                    <div class="legend"><span><i></i>All regions</span><span><i class="l"></i>North</span></div>
                    <div class="exports"><span>PNG</span><span>SVG</span><span>CSV</span></div>
                  </div>
                  <svg class="chart" viewBox="0 0 520 196">
                    {gridVals.map((g) => (
                      <g>
                        <line class="gl" x1="30" x2="516" y1={g.y} y2={g.y} />
                        <text x="0" y={g.y + 3}>{g.v}</text>
                      </g>
                    ))}
                    <rect class="band" x={q3x} y="8" width={q3w} height={BASE - 8} rx="4" />
                    <text class="band-label" x={q3x + 8} y="22">Q3 −12.4%</text>
                    {bars.map((b) => (
                      <g>
                        <rect class={b.q3 ? "bar q3" : "bar"} x={b.x} y={b.y} width={BW} height={b.h} rx="2" style={`--bd:${b.d}`} />
                        <text x={b.x + BW / 2} y="190" text-anchor="middle">{b.m}</text>
                      </g>
                    ))}
                    <polyline class="nline" points={northPts} pathLength="1" />
                    {north.map((v, i) => (
                      <circle class="ndot" cx={X0 + i * STEP + BW / 2} cy={BASE - v * K} r="3" />
                    ))}
                  </svg>
                </div>
                <div class="chips">
                  <span class="chip">Compare North repeat rate by month</span>
                  <span class="chip">Which products lost the most?</span>
                  <span class="chip">Show Q3 vs Q2 by channel</span>
                </div>
              </div>

              <aside class="app-rec">
                <div class="rec-title">Mimir Recommends</div>
                <div class="rec lead">
                  <h5>Win back lapsed North accounts with a reorder offer</h5>
                  <dl>
                    <div><dt>Predicted outcome</dt><dd class="up">Recovers 6–8% of Q4 revenue</dd></div>
                    <div><dt>Cost of no action</dt><dd class="down">Q4 down a further 9%</dd></div>
                  </dl>
                  <p class="why">38% of North customers who ordered in Q2 have not reordered since July.</p>
                </div>
                <div class="rec">
                  <h5>Review North delivery times</h5>
                  <dl>
                    <div><dt>Predicted outcome</dt><dd class="up">Fewer cancelled repeat orders</dd></div>
                  </dl>
                </div>
              </aside>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= FEATURES ================= -->
    <section class="section alt" id="features">
      <div class="wrap">
        <h2 class="sec-title">Core Features</h2>

        <div class="feature-grid">
          <article class="feature spot" data-loop>
            <div class="viz viz-analysis" aria-hidden="true">
              <svg viewBox="0 0 400 140" preserveAspectRatio="none">
                <defs>
                  <linearGradient id="fa" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#009DFF" stop-opacity=".18" />
                    <stop offset="1" stop-color="#009DFF" stop-opacity="0" />
                  </linearGradient>
                </defs>
                <line class="gl" x1="0" x2="400" y1="35" y2="35" vector-effect="non-scaling-stroke" />
                <line class="gl" x1="0" x2="400" y1="70" y2="70" vector-effect="non-scaling-stroke" />
                <line class="gl" x1="0" x2="400" y1="105" y2="105" vector-effect="non-scaling-stroke" />
                <path class="ar" d="M0,112 L40,98 L80,102 L120,84 L160,88 L200,68 L240,74 L280,26 L320,78 L360,60 L400,50 L400,140 L0,140Z" fill="url(#fa)" />
                <polyline class="ln" points="0,112 40,98 80,102 120,84 160,88 200,68 240,74 280,26 320,78 360,60 400,50" vector-effect="non-scaling-stroke" />
              </svg>
              <span class="anomaly" style="left:70%;top:calc(14px + (100% - 14px) * 0.186)"></span>
              <span class="viz-tag" style="right:calc(30% + 16px);top:calc(14px + (100% - 14px) * 0.186 - 11px)">Anomaly in Aug</span>
              <span class="scan"></span>
            </div>
            <h3>Instant Analysis and Visualisation</h3>
            <p>Upload your file - Mimir analyzes the data, draws clear charts, and explains what’s happening in seconds.<b>Patterns, anomalies, and insights - all at a glance.</b></p>
          </article>

          <article class="feature spot" data-loop>
            <div class="viz viz-rows" aria-hidden="true">
              <div class="vrow" style="--rd:0s"><i class="dot g"></i>Opportunity<span class="meter" style="color:var(--green)"><em style="--w:78%"></em></span></div>
              <div class="vrow" style="--rd:1.2s"><i class="dot r"></i>Risk<span class="meter" style="color:var(--red)"><em style="--w:46%"></em></span></div>
              <div class="vrow" style="--rd:2.4s"><i class="dot b"></i>Next step<span class="meter" style="color:var(--accent)"><em style="--w:92%"></em></span></div>
            </div>
            <h3>Actionable Recommendations</h3>
            <p>Mimir doesn’t just show results - it tells you what to do next.<b>Opportunities, risks, and clear next steps - ready to act on immediately.</b></p>
          </article>

          <article class="feature spot" data-loop>
            <div class="viz viz-rows" aria-hidden="true">
              <div class="vrow ask" style="--rd:0s">Why did returns rise in March?</div>
              <div class="vrow ask" style="--rd:1.2s">Split this by customer type</div>
              <div class="vrow ask" style="--rd:2.4s">Which stores grew fastest?</div>
            </div>
            <h3>Smart Follow-Up Questions</h3>
            <p>After each analysis, Mimir suggests what to explore next, uncovering hidden insights you might have missed.<b>Think of it as an analyst guiding you step by step.</b></p>
          </article>

          <article class="feature spot" data-loop>
            <div class="viz viz-time" aria-hidden="true">
              <svg viewBox="0 0 300 80" preserveAspectRatio="none">
                <polyline class="ln" points="0,70 50,63 100,56 150,50 200,36 250,27 300,10" vector-effect="non-scaling-stroke" />
              </svg>
              <div class="files">
                <span style="--fd:0s">jan.csv</span><span style="--fd:.5s">feb.csv</span><span style="--fd:1s">mar.csv</span><span style="--fd:1.5s">apr.csv</span>
              </div>
            </div>
            <h3>Continuous Understanding</h3>
            <p>Every file you analyze helps Mimir spot trends, patterns, and changes over time.<b>Your business story, always evolving - automatically.</b></p>
          </article>

          <article class="feature spot" data-loop>
            <div class="viz viz-drop" aria-hidden="true">
              <div class="zone"><span class="drop-file">q3_sales.xlsx</span></div>
              <div class="fmts"><span>.csv</span><span>.xls</span><span>.xlsx</span></div>
            </div>
            <h3>Effortless Setup</h3>
            <p>No dashboards, no SQL, no configuration. Upload a file, and Mimir does the rest.<b>Analysis the way it's supposed to be - Quick & Simple.</b></p>
          </article>

          <article class="feature spot" data-loop>
            <div class="viz viz-lock" aria-hidden="true">
              <div class="rings">
                <i></i><i></i><i></i>
                <svg viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M8 10V7a4 4 0 1 1 8 0v3h1a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h1Zm2-3a2 2 0 1 1 4 0v3h-4V7Zm2 6a1 1 0 0 1 1 1v3a1 1 0 1 1-2 0v-3a1 1 0 0 1 1-1Z" clip-rule="evenodd"/></svg>
              </div>
            </div>
            <h3>Secure by Design</h3>
            <p>Your data is processed safely with end-to-end encryption. Access is tightly controlled, and your insights remain confidential.<b>Analysis you can trust - private and secure.</b></p>
          </article>
        </div>
      </div>
    </section>

    <!-- ================= HOW IT WORKS ================= -->
    <section class="section" id="how">
      <div class="wrap how-grid">
        <div class="how-intro">
          <h2 class="sec-title">How It Works</h2>
          <div class="pipe" aria-hidden="true" data-loop>
            <svg viewBox="0 0 440 220">
              <path class="wire" d="M120 110 H180" />
              <path class="wire" d="M260 110 C 290 110, 290 46, 320 46" />
              <path class="wire" d="M260 110 H320" />
              <path class="wire" d="M260 110 C 290 110, 290 174, 320 174" />
              <path class="pulse" d="M120 110 H180" pathLength="1" />
              <path class="pulse p2" d="M260 110 C 290 110, 290 46, 320 46" pathLength="1" />
              <path class="pulse p3" d="M260 110 H320" pathLength="1" />
              <path class="pulse p4" d="M260 110 C 290 110, 290 174, 320 174" pathLength="1" />
              <rect class="box" x="16" y="88" width="104" height="44" rx="6" />
              <text x="68" y="115" text-anchor="middle">data.csv</text>
              <rect class="hub" x="180" y="70" width="80" height="80" rx="10" />
              <image href={logo.src} x="202" y="92" width="36" height="36" />
              <rect class="box" x="320" y="26" width="108" height="40" rx="6" />
              <text x="374" y="51" text-anchor="middle">Summary</text>
              <rect class="box" x="320" y="90" width="108" height="40" rx="6" />
              <text x="374" y="115" text-anchor="middle">Chart</text>
              <rect class="box" x="320" y="154" width="108" height="40" rx="6" />
              <text x="374" y="179" text-anchor="middle">Next steps</text>
            </svg>
          </div>
        </div>

        <ol class="timeline" data-loop>
          {steps.map((s) => (
            <li class="step">
              <div class="node">{s.n}</div>
              <div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ================= TESTIMONIALS ================= -->
    <section class="section alt" id="testimonials">
      <div class="wrap">
        <h2 class="sec-title">Testimonials</h2>
        <div class="quotes">
          {testimonials.map((t) => (
            <figure class="quote">
              <blockquote>“{t.quote}”</blockquote>
              <figcaption class="who">
                <strong>{t.name}</strong>
                <span>{t.role}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= COMPARISON ================= -->
    <section class="section" id="comparison">
      <div class="wrap">
        <h2 class="sec-title">Comparison</h2>
        <div class="cmp" role="table" aria-label="Mimir compared with cloud tools">
          <div class="cmp-row cmp-head" role="row">
            <div role="columnheader">Feature</div>
            <div role="columnheader" class="m"><img src={logo.src} alt="" width="16" height="16" />Mimir</div>
            <div role="columnheader">Cloud tools</div>
          </div>
          {comparison.map((row) => (
            <div class="cmp-row" role="row">
              <div role="rowheader" class="feat">{row.feature}</div>
              <div role="cell" class="m">
                <span class="cell-label">Mimir</span>
                <svg class="ic yes" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.4l3.2 3.1L13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {row.mimir}
              </div>
              <div role="cell">
                <span class="cell-label">Cloud tools</span>
                <svg class="ic no" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                {row.others}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= FINAL CTA ================= -->
    <section class="final" id="start">
